rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /posts/{postId} {
      allow read: if true;

allow create: if request.auth != null
  && request.resource.data.keys().hasAll(['title', 'body', 'userId', 'createdAt'])
  && request.resource.data.keys().hasOnly(['title', 'body', 'userId', 'createdAt'])
  && request.resource.data.title is string
  && request.resource.data.body is string
  && request.resource.data.title.size() > 0
  && request.resource.data.title.size() <= 100
  && request.resource.data.body.size() > 0
  && request.resource.data.body.size() <= 2000
  && request.resource.data.userId == request.auth.uid
  && request.resource.data.createdAt == request.time;
    
      allow update: if request.auth != null
  && resource.data.userId == request.auth.uid
  && request.resource.data.userId == resource.data.userId
  && request.resource.data.diff(resource.data).affectedKeys()
       .hasOnly(['title', 'body'])
  && request.resource.data.title is string
  && request.resource.data.body is string
  && request.resource.data.title.size() > 0
  && request.resource.data.title.size() <= 100
  && request.resource.data.body.size() > 0
  && request.resource.data.body.size() <= 2000;

allow delete: if request.auth != null
  && resource.data.userId == request.auth.uid;
    }
match /importedPosts/{documentId} {
      allow get: if request.auth != null
    && (
      !exists(/databases/$(database)/documents/importedPosts/$(documentId))
      || resource.data.userId == request.auth.uid
    );

  allow list: if request.auth != null
    && resource.data.userId == request.auth.uid;

  allow create: if request.auth != null
    && request.resource.data.userId == request.auth.uid;

 allow update: if request.auth != null
  && resource.data.userId == request.auth.uid
  && request.resource.data.userId == request.auth.uid;

allow delete: if false;
    }
    
  }
}